// Example scene in the plugin's pseudo-code format.
VARS
  met_envoy: bool = false
  reputation_guild: int = 0
  gold: int = 25

== guild_start == #entry
ENVOY: [wary] You're late. The Guild doesn't wait.
(set met_envoy = true)
(if reputation_guild >= 3)
  ENVOY: ...though for you, I'll make an exception.
(else)
  ENVOY: State your business or leave.
(end)

> "I came about the contract."             -> ask_terms
> "Here. For your trouble." {if gold >= 10} {gold -= 10} {reputation_guild += 1} -> ask_terms
> "Not telling you." {reputation_guild -= 1}
    ENVOY: [cold] Then we're done here.
    -> END

== ask_terms ==
ENVOY: Half upfront, half on delivery. No exceptions.
The envoy slides a sealed ledger across the table.

> "Deal."          {reputation_guild += 1} -> accepted
> "Too steep."     -> haggle

== haggle ==
ENVOY: [amused] Brave. Foolish, but brave.
(call play_sfx "ledger_slam")
-> accepted

== accepted ==
ENVOY: Then we understand each other.
-> END
